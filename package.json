{
  "name": "jewelry-catalog-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-style product catalog REST API for a backend internship assignment",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
